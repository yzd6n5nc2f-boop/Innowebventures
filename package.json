{
  "name": "innoweb-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-staticwebapp-config.mjs && node scripts/build-campaign-pages.mjs && node scripts/build-page-meta.mjs && node scripts/build-sitemap.mjs && node scripts/build-routing.mjs",
    "preview": "vite preview",
    "test:sitemap": "node --test scripts/build-sitemap.test.mjs",
    "test:routing": "node --test scripts/build-routing.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
