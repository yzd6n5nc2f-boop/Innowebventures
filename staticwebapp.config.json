{
  "routes": [
    {
      "route": "/privacy-policy",
      "rewrite": "/privacy-policy/index.html"
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
